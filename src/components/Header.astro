---
const path = Astro.url.pathname;
const links = [
  { href: '/', label: '首頁' },
  { href: '/blog/', label: '文章' },
  { href: '/tags/', label: '標籤' },
  { href: '/projects/', label: '專案' },
  { href: '/about/', label: '關於' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="container wide bar">
    <a class="brand" href="/">YuanYe<span>YouTao</span></a>
    <nav>
      {links.map((l) => (
        <a href={l.href} class:list={[{ active: isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <button id="theme-toggle" aria-label="切換深淺色">
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
  // 沒有手動選過主題時，跟著系統切換
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let saved = null;
    try { saved = localStorage.getItem('theme'); } catch (err) {}
    if (!saved) root.dataset.theme = e.matches ? 'dark' : 'light';
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 60px; gap: 12px; }
  .brand { font-family: var(--serif); font-weight: 700; font-size: 1.15rem; color: var(--text); }
  .brand span { color: var(--accent); }
  .brand:hover { text-decoration: none; }
  nav { display: flex; align-items: center; gap: 4px; }
  nav a { color: var(--muted); padding: 6px 10px; border-radius: 8px; font-size: 0.95rem; }
  nav a:hover { color: var(--text); background: var(--bg-soft); text-decoration: none; }
  nav a.active { color: var(--text); font-weight: 500; }
  button {
    display: grid; place-items: center; width: 34px; height: 34px; margin-left: 4px;
    border: 1px solid var(--line); border-radius: 8px; background: transparent;
    color: var(--muted); cursor: pointer;
  }
  button:hover { color: var(--text); }
  .moon { display: none; }
  :global([data-theme='dark']) .sun { display: none; }
  :global([data-theme='dark']) .moon { display: block; }
  @media (max-width: 520px) {
    .brand span { display: none; }
    nav a { padding: 6px 7px; }
  }
</style>
