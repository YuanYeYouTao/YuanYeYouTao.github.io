---
import type { Project } from '../data/projects';
interface Props { project: Project; }
const { project: p } = Astro.props;
---
<a class="card" href={p.repo} target="_blank" rel="noopener">
  <div class="top">
    <h3>{p.name}</h3>
    {p.role && <span class="role">{p.role}</span>}
  </div>
  <p>{p.description}</p>
  <div class="meta">
    {p.language && <span class="lang"><i></i>{p.language}</span>}
    {p.tags.map((t) => <span class="tag">{t}</span>)}
  </div>
</a>
<style>
  .card {
    display: flex; flex-direction: column; gap: 10px; height: 100%;
    padding: 22px; border-radius: 14px; background: var(--card);
    border: 1px solid var(--line); box-shadow: var(--shadow); color: var(--text);
    transition: transform 0.15s, border-color 0.15s;
  }
  .card:hover { transform: translateY(-2px); border-color: var(--accent); text-decoration: none; }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  h3 { margin: 0; font-size: 1.15rem; word-break: break-word; }
  .role { font-size: 0.8rem; color: var(--muted); white-space: nowrap; }
  p { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.7; flex: 1; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .lang { font-size: 0.82rem; color: var(--muted); display: inline-flex; align-items: center; gap: 6px; margin-right: 4px; }
  .lang i { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); }
</style>
