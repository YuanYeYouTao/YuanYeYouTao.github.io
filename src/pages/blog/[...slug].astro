---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i + 1], next: posts[i - 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={post.data.title} description={post.data.description}>
  <article class="container">
    <header>
      <a class="back" href="/blog/">← 所有文章</a>
      <h1>{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
        {post.data.updatedDate && <span>· 更新於 {fmt(post.data.updatedDate)}</span>}
        {post.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <nav class="pager">
      {prev ? <a href={`/blog/${prev.id}/`}>← {prev.data.title}</a> : <span></span>}
      {next ? <a href={`/blog/${next.id}/`}>{next.data.title} →</a> : <span></span>}
    </nav>
  </article>
</Base>
<style>
  header { padding: 56px 0 12px; border-bottom: 1px solid var(--line); margin-bottom: 12px; }
  .back { font-size: 0.9rem; color: var(--muted); }
  h1 { font-size: clamp(1.8rem, 5vw, 2.4rem); margin: 12px 0 14px; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; color: var(--muted); font-size: 0.92rem; padding-bottom: 20px; }
  .pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--line); font-size: 0.95rem; }
</style>
