---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import { projects } from '../data/projects';
import { getPosts } from '../utils';
import { GITHUB } from '../consts';

const featured = projects.filter((p) => p.featured);
const posts = (await getPosts()).slice(0, 5);
---
<Base>
  <section class="hero container wide">
    <p class="eyebrow">你好，我是</p>
    <h1>YuanYeYouTao</h1>
    <p class="lead">
      喜歡做 <strong>會記得人的 AI Agent</strong> 與順手的開發者工具。
      關注持久社交 Agent、長期記憶、MCP 與終端介面，也在大學裡啃數學與電腦科學。
    </p>
    <div class="cta">
      <a class="btn primary" href="/projects/">看看我的專案</a>
      <a class="btn" href={GITHUB} target="_blank" rel="noopener">GitHub →</a>
    </div>
  </section>

  <section class="container wide">
    <div class="section-title">
      <h2>精選專案</h2>
      <a href="/projects/">全部專案 →</a>
    </div>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="container wide">
    <div class="section-title">
      <h2>最新文章</h2>
      <a href="/blog/">所有文章 →</a>
    </div>
    <PostList posts={posts} />
  </section>
</Base>

<style>
  .hero { padding: 88px 0 24px; }
  .eyebrow { margin: 0; color: var(--accent); font-weight: 500; letter-spacing: 0.05em; }
  h1 { font-size: clamp(2.4rem, 7vw, 4rem); margin: 4px 0 18px; }
  .lead { font-size: 1.15rem; color: var(--muted); max-width: 640px; margin: 0; }
  .lead strong { color: var(--text); font-weight: 500; }
  .cta { display: flex; gap: 12px; margin-top: 32px; flex-wrap: wrap; }
  .btn {
    padding: 10px 20px; border-radius: 10px; border: 1px solid var(--line);
    color: var(--text); font-weight: 500; font-size: 0.95rem;
  }
  .btn:hover { text-decoration: none; border-color: var(--accent); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  :global([data-theme='dark']) .btn.primary { color: #1f1b16; }
  .btn.primary:hover { filter: brightness(1.08); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 18px; }
</style>
