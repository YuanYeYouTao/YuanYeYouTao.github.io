---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import { projects } from '../data/projects';
import { getPosts } from '../utils';
import { GITHUB, EMAIL } from '../consts';

const posts = await getPosts();
const featured = projects;
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const since = new Date('2026-07-23T00:00:00+08:00');
const uptime = Math.max(0, Math.floor((Date.now() - since.getTime()) / 86400000));

const data = {
  projects: projects.map((p) => ({ id: p.name.toLowerCase(), name: p.name, repo: p.repo, desc: p.description, role: p.role ?? '', lang: p.language ?? '' })),
  posts: posts.map((p) => ({ id: p.id, title: p.data.title, date: fmt(p.data.pubDate), url: `/blog/${p.id}/` })),
  github: GITHUB,
  email: EMAIL,
  since: since.toISOString(),
};

const logo = String.raw`
       .     |     .
        \    |    /
    .    \   |   /    .
     '--. \  |  / .--'
  --------- (*) ---------
     .--' /  |  \ '--.
    '    /   |   \    '
        /    |    \
       '     |     '`;
---
<Base bare description="YuanYeYouTao：做 AI Agent 和開發者工具。仿如來自虛空。">
  <script is:inline slot="head">
    (() => {
      let seen = null;
      try { seen = sessionStorage.getItem('void-entered'); } catch (e) {}
      if (!seen || new URLSearchParams(location.search).has('cover')) document.documentElement.dataset.cover = 'on';
    })();
  </script>

  <Cover />

  <div class="term">
    <div class="window">
      <div class="titlebar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="title">yuanyeyoutao@void: ~</span>
        <nav class="tabs" aria-label="網站導覽">
          <a href="/blog/">blog</a>
          <a href="/projects/">projects</a>
          <a href="/tags/">tags</a>
          <a href="/about/">about</a>
          <a href="/rss.xml">rss</a>
        </nav>
      </div>

      <div class="screen" id="screen">
        <pre class="bootlog" id="bootlog" aria-hidden="true"></pre>
        <p class="motd">Last login: <span id="last-login">—</span> on ttys000 · 輸入 <kbd>help</kbd> 查看可用指令</p>

        <section class="block boot" id="neofetch">
          <div class="cmd"><span class="ps1">~ $</span> <span class="typed" data-text="neofetch">neofetch</span></div>
          <div class="out fetch">
            <pre class="logo" aria-hidden="true">{logo}</pre>
            <div class="info">
              <p class="who glitch" data-text="yuanyeyoutao@void"><b>yuanyeyoutao</b>@<b>void</b></p>
              <p class="sep">-------------------</p>
              <p><span class="k">OS</span>仿如來自虛空</p>
              <p><span class="k">Role</span>做 AI Agent 和開發者工具</p>
              <p><span class="k">Owner</span><a href="https://github.com/YuanYeYouTao/Yuki">Yuki</a>，會記得人的社交 AI Agent</p>
              <p><span class="k">Core Dev</span><a href="https://github.com/Hilbert-beinghappy/seektty">SeekTTY</a>，DeepSeek Harness 的終端工作區</p>
              <p><span class="k">Focus</span>持久社交 Agent・長期記憶・持久工作・MCP・終端介面</p>
              <p><span class="k">Cares</span>可靠的系統・清楚的權限邊界・順手的開發者體驗</p>
              <p><span class="k">Stack</span>Python・TypeScript・Docker・SQLite・MCP</p>
              <p><span class="k">Uptime</span>Yuki 已運行 <span id="uptime">{uptime}</span> 天</p>
              <p><span class="k">Contact</span><a href={GITHUB}>GitHub</a> ・ <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
              <p class="swatch" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></p>
            </div>
          </div>
        </section>

        <section class="block boot">
          <div class="cmd"><span class="ps1">~ $</span> <span class="typed" data-text="ls projects/">ls projects/</span></div>
          <ul class="out list">
            {featured.map((p) => (
              <li>
                <a class="name" href={p.repo}>{p.name}/</a>
                <span class="meta">{p.role} · {p.language}</span>
                <span class="desc">{p.description}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="block boot">
          <div class="cmd"><span class="ps1">~ $</span> <span class="typed" data-text="ls posts/ | head -5">ls posts/ | head -5</span></div>
          <ul class="out list posts">
            {posts.slice(0, 5).map((p) => (
              <li>
                <time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time>
                <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              </li>
            ))}
            <li class="more"><a href="/blog/">→ 全部 {posts.length} 篇文章：cd blog</a></li>
          </ul>
        </section>

        <div id="history" aria-live="polite"></div>

        <form class="prompt" id="prompt" autocomplete="off">
          <label class="ps1" for="cmd-input">~ $</label>
          <input id="cmd-input" name="cmd" spellcheck="false" autocapitalize="off" aria-label="輸入指令，例如 help" />
          <span class="caret" aria-hidden="true"></span>
        </form>
      </div>
      <div class="status" aria-hidden="true">
        <span class="seg hl">[void]</span><span class="seg">0:zsh*</span><span class="seg dim">1:yuki</span><span class="seg dim">2:seektty</span>
        <span class="grow"></span>
        <span class="seg">λ <span id="st-lambda">0.00</span></span><span class="seg" id="st-clock">--:--:--</span><span class="seg hl" id="st-date">----</span>
      </div>
    </div>
    <p class="foot">© {new Date().getFullYear()} YuanYeYouTao · <a href="/?cover">重播封面</a></p>
  </div>

  <script type="application/json" id="term-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  type Data = {
    projects: { id: string; name: string; repo: string; desc: string; role: string; lang: string }[];
    posts: { id: string; title: string; date: string; url: string }[];
    github: string; email: string; since: string;
  };
  const data: Data = JSON.parse(document.getElementById('term-data')!.textContent!);
  const root = document.documentElement;
  const screen = document.getElementById('screen')!;
  const history = document.getElementById('history')!;
  const form = document.getElementById('prompt') as HTMLFormElement;
  const input = document.getElementById('cmd-input') as HTMLInputElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  document.getElementById('last-login')!.textContent = new Date().toLocaleString('zh-TW', { hour12: false });
  document.getElementById('uptime')!.textContent = String(Math.floor((Date.now() - Date.parse(data.since)) / 86400000));

  // ---------- 開機動畫：只在剛從封面進來時播放 ----------
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  let skipping = false;
  const BOOT = [
    'Booting void kernel 6.9.0-yuki (tty0)',
    'Mounting /dev/memory on /self',
    'Starting chat-events ledger (append-only)',
    'Starting canonical identity: Person / Space / Presence',
    'Starting semantic observer: jev',
    'Starting participation controller (lambda sampler)',
    'Starting persistent workspace (gVisor)',
    'Reached target yuki-agent.service',
    'Reached target Graphical Terminal',
  ];
  async function bootLog() {
    const pre = document.getElementById('bootlog')!;
    pre.classList.add('on');
    for (const line of BOOT) {
      if (skipping) break;
      const ok = Math.random() < 0.94;
      const tag = ok ? '[  OK  ]' : '[ WAIT ]';
      pre.insertAdjacentHTML('beforeend', `<span class="${ok ? 'ok' : 'wait'}">${tag}</span> ${esc(line)}` + '\n');
      await sleep(70 + Math.random() * 110);
    }
    await sleep(skipping ? 0 : 260);
    pre.classList.add('fold');
  }
  async function boot() {
    const blocks = [...screen.querySelectorAll<HTMLElement>('.block.boot')];
    if (reduce || !blocks.length) return focusInput();
    blocks.forEach((b) => b.classList.add('pending'));
    form.classList.add('pending');
    const skip = () => { skipping = true; };
    addEventListener('keydown', skip, { once: true });
    screen.addEventListener('click', skip, { once: true });
    document.querySelector('.window')!.classList.add('power-on');
    await sleep(420);
    await bootLog();
    for (const b of blocks) {
      const typed = b.querySelector<HTMLElement>('.typed')!;
      const text = typed.dataset.text ?? typed.textContent ?? '';
      typed.textContent = '';
      b.classList.remove('pending');
      b.classList.add('typing');
      for (const ch of text) {
        if (skipping) break;
        typed.textContent += ch;
        await sleep(28 + Math.random() * 40);
      }
      typed.textContent = text;
      b.classList.remove('typing');
      if (!skipping) await sleep(160);
      const rows = [...b.querySelectorAll<HTMLElement>('.out > *, .out .info > *')];
      rows.forEach((r) => r.classList.add('hide'));
      for (const r of rows) {
        r.classList.remove('hide');
        if (!skipping) await sleep(45);
      }
      if (!skipping) await sleep(220);
    }
    form.classList.remove('pending');
    focusInput();
  }
  function focusInput() { input.focus({ preventScroll: true }); }

  // ---------- tmux 狀態列 ----------
  const lam = document.getElementById('st-lambda')!;
  const clock = document.getElementById('st-clock')!;
  const day = document.getElementById('st-date')!;
  let lv = 0.3;
  const tickStatus = () => {
    const now = new Date();
    clock.textContent = now.toLocaleTimeString('zh-TW', { hour12: false });
    day.textContent = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    lv = Math.min(0.99, Math.max(0.01, lv + (Math.random() - 0.5) * 0.08));
    lam.textContent = lv.toFixed(2);
  };
  tickStatus();
  setInterval(tickStatus, 1000);

  // ---------- 連結解碼效果 ----------
  const GLYPHS = '!<>-_/[]{}=+*^?#01ABCDEF';
  const decode = (a: HTMLElement) => {
    if (reduce || a.dataset.busy || a.children.length) return;
    const text = a.textContent ?? '';
    a.dataset.busy = '1';
    let f = 0;
    const id = setInterval(() => {
      f++;
      a.textContent = [...text]
        .map((c, i) => (i < f / 2 || c === ' ' || c.charCodeAt(0) > 0x2e7f ? c : GLYPHS[Math.floor(Math.random() * GLYPHS.length)]))
        .join('');
      if (f / 2 >= text.length) { clearInterval(id); a.textContent = text; delete a.dataset.busy; }
    }, 22);
  };
  document.querySelector('.term')!.addEventListener('mouseover', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLElement>('.screen a, .tabs a');
    if (a) decode(a);
  });

  if (root.dataset.cover === 'on') addEventListener('cover:exit', () => boot(), { once: true });
  else focusInput();

  // ---------- 指令 ----------
  const print = (cmd: string, html: string) => {
    const el = document.createElement('section');
    el.className = 'block';
    el.innerHTML = `<div class="cmd"><span class="ps1">~ $</span> <span class="typed">${esc(cmd)}</span></div>` + (html ? `<div class="out">${html}</div>` : '');
    history.append(el);
    el.scrollIntoView({ block: 'end' });
  };
  const go = (url: string) => { location.href = url; };
  const projList = (list = data.projects) => `<ul class="list">${list.map((p) => `<li><a class="name" href="${p.repo}">${esc(p.name)}/</a><span class="meta">${esc([p.role, p.lang].filter(Boolean).join(' · '))}</span><span class="desc">${esc(p.desc)}</span></li>`).join('')}</ul>`;
  const postList = (list = data.posts) => `<ul class="list posts">${list.map((p, i) => `<li><span class="idx">${i + 1}</span><time>${p.date}</time><a href="${p.url}">${esc(p.title)}</a></li>`).join('')}</ul>`;

  const commands: Record<string, { help: string; run: (args: string[]) => string | void }> = {
    help: { help: '列出可用指令', run: () => `<ul class="list help">${Object.entries(commands).map(([k, v]) => `<li><span class="name">${k}</span><span class="desc">${v.help}</span></li>`).join('')}</ul><p class="dim">Tab 自動補全，↑ ↓ 翻歷史指令。</p>` },
    whoami: { help: '我是誰', run: () => `<p>YuanYeYouTao（遠野）。做 AI Agent 和開發者工具，仿如來自虛空。</p>` },
    neofetch: { help: '系統資訊', run: () => (document.querySelector('#neofetch .out') as HTMLElement).outerHTML.replace(/ hide/g, '') },
    projects: { help: '列出全部專案', run: () => projList() },
    posts: { help: '列出全部文章', run: () => postList() },
    ls: { help: 'ls projects | ls posts', run: (a) => (a[0]?.startsWith('post') || a[0]?.startsWith('blog') ? postList() : a[0]?.startsWith('proj') ? projList() : `<p><span class="name">projects/</span>&nbsp;&nbsp;<span class="name">posts/</span>&nbsp;&nbsp;about.txt&nbsp;&nbsp;contact.txt</p>`) },
    open: { help: 'open <專案名稱 | 文章編號>', run: (a) => {
      const q = (a[0] ?? '').toLowerCase();
      if (!q) return `<p class="err">用法：open yuki，或 open 1（文章編號，見 posts）</p>`;
      const n = Number(q);
      if (Number.isInteger(n) && data.posts[n - 1]) { go(data.posts[n - 1].url); return `<p class="dim">opening ${esc(data.posts[n - 1].title)} …</p>`; }
      const p = data.projects.find((x) => x.id === q || x.id.startsWith(q)) ;
      if (p) { window.open(p.repo, '_blank', 'noopener'); return `<p class="dim">opening ${esc(p.repo)} …</p>`; }
      return `<p class="err">找不到「${esc(q)}」。</p>`;
    } },
    cd: { help: 'cd blog | projects | tags | about', run: (a) => {
      const map: Record<string, string> = { blog: '/blog/', posts: '/blog/', projects: '/projects/', tags: '/tags/', about: '/about/', '~': '/', '/': '/' };
      const t = map[(a[0] ?? '~').replace(/\/$/, '')];
      if (!t) return `<p class="err">cd: no such directory: ${esc(a[0])}</p>`;
      go(t);
    } },
    'cat': { help: 'cat about.txt | contact.txt', run: (a) => (a[0] === 'contact.txt' ? commands.contact.run([]) : commands.whoami.run([])) },
    contact: { help: '聯絡方式', run: () => `<p>GitHub　<a href="${data.github}">${data.github}</a></p><p>Email　<a href="mailto:${data.email}">${data.email}</a></p>` },
    rss: { help: '訂閱 RSS', run: () => { go('/rss.xml'); } },
    cover: { help: '回到封面', run: () => { go('/?cover'); } },
    date: { help: '現在時間', run: () => `<p>${new Date().toString()}</p>` },
    echo: { help: 'echo <文字>', run: (a) => `<p>${esc(a.join(' '))}</p>` },
    sudo: { help: '以管理員身份執行', run: () => `<p class="err">Permission denied：權限在後端，不在 prompt。</p>` },
    yuki: { help: '叫一下 Yuki', run: () => `<p class="dim">[semantic] observe → invite_yuki? unknown</p><p>NO_REPLY</p>` },
    clear: { help: '清除畫面', run: () => { history.innerHTML = ''; screen.querySelectorAll('.block.boot, .motd').forEach((b) => b.remove()); } },
  };

  const past: string[] = [];
  let cursor = 0;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const raw = input.value.trim();
    input.value = '';
    if (!raw) { print('', ''); return; }
    past.push(raw); cursor = past.length;
    const [name, ...args] = raw.split(/\s+/);
    const c = commands[name.toLowerCase()];
    if (!c) return print(raw, `<p class="err">command not found: ${esc(name)}。輸入 help 查看可用指令。</p>`);
    const out = c.run(args);
    if (name.toLowerCase() !== 'clear') print(raw, out ?? '');
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowUp' && past.length) { e.preventDefault(); cursor = Math.max(0, cursor - 1); input.value = past[cursor]; }
    else if (e.key === 'ArrowDown') { e.preventDefault(); cursor = Math.min(past.length, cursor + 1); input.value = past[cursor] ?? ''; }
    else if (e.key === 'Tab') {
      e.preventDefault();
      const [name, arg] = input.value.split(/\s+/);
      if (arg === undefined) {
        const hit = Object.keys(commands).filter((k) => k.startsWith(name));
        if (hit.length === 1) input.value = hit[0] + ' ';
        else if (hit.length > 1) print(input.value, `<p>${hit.join('&nbsp;&nbsp;')}</p>`);
      } else if (name === 'open' || name === 'cd') {
        const pool = name === 'open' ? data.projects.map((p) => p.id) : ['blog', 'projects', 'tags', 'about'];
        const hit = pool.filter((k) => k.startsWith(arg.toLowerCase()));
        if (hit.length === 1) input.value = `${name} ${hit[0]}`;
      }
    }
  });
  screen.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('a') && !getSelection()?.toString()) focusInput();
  });
</script>

<style is:global>
  html:has(.term) { color-scheme: dark; }
  html:has(.term) body { background: #0a0806; }
</style>

<style>
  .term {
    --amber: #ffb000;
    --amber-dim: rgba(255, 176, 0, 0.55);
    --ink: #eadfc8;
    --dim: #8f8471;
    --line: rgba(255, 176, 0, 0.18);
    min-height: 100vh; min-height: 100dvh;
    padding: clamp(12px, 4vw, 48px) 16px 24px;
    background: radial-gradient(ellipse at top, #16110a 0%, #0a0806 60%);
    color: var(--ink);
    font-family: 'JetBrains Mono', ui-monospace, 'Cascadia Code', Consolas, 'Noto Sans TC', monospace;
    font-size: 14.5px; line-height: 1.7;
    font-variant-ligatures: none;
  }
  .window {
    position: relative;
    max-width: 980px; margin: 0 auto;
    border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
    background: rgba(12, 9, 6, 0.92);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55), 0 0 0 1px #000;
  }
  /* 掃描線與掃過的亮帶 */
  .window::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 2;
    background: repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0.18) 0 1px, transparent 1px 3px);
  }
  .window::after {
    content: ''; position: absolute; left: 0; right: 0; top: -30%; height: 30%; pointer-events: none; z-index: 2;
    background: linear-gradient(to bottom, transparent, rgba(255, 176, 0, 0.045), transparent);
    animation: sweep 7s linear infinite;
  }
  @keyframes sweep { to { top: 110%; } }
  .window { animation: flick 6s infinite steps(1); }
  @keyframes flick { 0%, 100% { opacity: 1; } 61% { opacity: 0.96; } 62% { opacity: 1; } 88% { opacity: 0.985; } }
  .window.power-on { animation: power 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) both, flick 6s 0.6s infinite steps(1); }
  @keyframes power {
    0% { transform: scale(0.02, 0.004); filter: brightness(5); opacity: 0; }
    40% { transform: scale(1, 0.004); filter: brightness(3); opacity: 1; }
    100% { transform: scale(1, 1); filter: brightness(1); }
  }

  .titlebar {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    padding: 10px 16px; border-bottom: 1px solid var(--line);
    background: rgba(255, 176, 0, 0.04); color: var(--dim); font-size: 13px;
  }
  .dots { display: inline-flex; gap: 7px; }
  .dots i { width: 11px; height: 11px; border-radius: 50%; background: #3a2f22; }
  .dots i:first-child { background: var(--amber); opacity: 0.8; }
  .title { flex: 1; }
  .tabs { display: flex; gap: 4px; flex-wrap: wrap; }
  .tabs a { color: var(--dim); padding: 2px 8px; border-radius: 6px; }
  .tabs a:hover { color: var(--amber); background: rgba(255, 176, 0, 0.08); text-decoration: none; }

  .screen { padding: 18px clamp(14px, 3vw, 28px) 26px; cursor: text; }
  .screen :global(a) { color: var(--amber); text-decoration: none; border-bottom: 1px dotted var(--amber-dim); }
  .screen :global(a:hover) { border-bottom-style: solid; text-decoration: none; }
  .screen :global(p) { margin: 0; }
  .motd { color: var(--dim); font-size: 13px; margin-bottom: 14px !important; }

  .bootlog { display: none; margin: 0 0 12px; font: inherit; font-size: 12.5px; line-height: 1.55; color: var(--dim); white-space: pre-wrap; }
  .bootlog.on { display: block; }
  .bootlog.fold { animation: fold 0.5s ease forwards; overflow: hidden; }
  @keyframes fold { from { max-height: 400px; } to { max-height: 0; opacity: 0; margin: 0; } }
  .bootlog :global(.ok) { color: #7bd88f; }
  .bootlog :global(.wait) { color: var(--amber); }

  /* 名字的故障效果 */
  .glitch { position: relative; display: inline-block; }
  .glitch::before, .glitch::after {
    content: attr(data-text); position: absolute; inset: 0; pointer-events: none; opacity: 0; font-weight: 600;
  }
  .glitch::before { color: #ff5f3a; animation: gl1 4.2s infinite steps(1); }
  .glitch::after { color: #ffe08a; animation: gl2 4.2s infinite steps(1); }
  @keyframes gl1 {
    0%, 90%, 100% { opacity: 0; transform: none; clip-path: none; }
    91% { opacity: 0.9; transform: translate(-2px, 0); clip-path: inset(10% 0 55% 0); }
    93% { opacity: 0.9; transform: translate(2px, 1px); clip-path: inset(60% 0 5% 0); }
    95% { opacity: 0; }
  }
  @keyframes gl2 {
    0%, 91%, 100% { opacity: 0; transform: none; clip-path: none; }
    92% { opacity: 0.8; transform: translate(2px, -1px); clip-path: inset(40% 0 30% 0); }
    94% { opacity: 0.8; transform: translate(-1px, 0); clip-path: inset(5% 0 70% 0); }
    96% { opacity: 0; }
  }

  /* tmux 狀態列 */
  .status {
    display: flex; align-items: center; gap: 2px; flex-wrap: wrap;
    border-top: 1px solid var(--line); background: rgba(255, 176, 0, 0.07);
    font-size: 12px; color: var(--ink); padding: 0 6px;
  }
  .status .seg { padding: 3px 8px; }
  .status .seg.hl { background: var(--amber); color: #1a1208; font-weight: 600; }
